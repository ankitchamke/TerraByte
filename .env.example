# TerraByte Environment Configuration Template
# Copy to .env.staging for staging development/testing
# Copy to .env.production for production builds/deployment
# DO NOT commit real credentials or keys to git.

# 1. Project Reference
SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PROJECT_ID=your-project-ref

# 2. Public API Configuration (Safe for Client Bundles)
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-jwt-here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# 3. Server-Side Administrative Key (NEVER prefix with VITE_ — SERVER-SIDE ONLY)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 4. Shared Application Services (Server-side)
CRON_SECRET=your-cron-secret-here
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
