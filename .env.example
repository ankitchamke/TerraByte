# TerraByte Environment Configuration Template
# Copy this file to .env.local and fill in your Supabase credentials

# Supabase API Configuration (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps Routes API (Server-side only — DO NOT prefix with VITE_)
# Used for in-app driving distance and ETA estimation for assigned technicians
# Requires Google Cloud project with Routes API enabled and billing configured
GOOGLE_MAPS_SERVER_KEY=your-google-routes-api-key-here
